# This file contains example environment variables for the project
# Copy relevant sections to the appropriate directories

# =============================================================================
# WEB APPLICATION (.env in /web directory)
# =============================================================================

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/callback

# Azure Cosmos DB Configuration
# Get these from Azure Portal → Cosmos DB → Keys
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your_cosmos_primary_key_here

# Node Environment
NODE_ENV=development

# =============================================================================
# AZURE FUNCTIONS (local.settings.json in /functions/SendToKindle directory)
# =============================================================================

# Note: Azure Functions uses local.settings.json format, not .env
# See functions/SendToKindle/local.settings.json for the template

# SMTP Configuration (for sending emails to Kindle)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Send to Kindle

# Local output directory for EPUB files
LOCAL_OUTPUT_DIR=./output

# =============================================================================
# BROWSER EXTENSION (update directly in /extension/popup/popup.js)
# =============================================================================

# API URLs are configured directly in the extension code
# See extension/popup/popup.js CONFIG object
