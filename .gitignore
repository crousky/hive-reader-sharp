## .gitignore for Send to Kindle project
## Includes entries for .NET, Node.js, and browser extensions

# =============================================================================
# Node.js / Web Application
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.astro/
.env
.env.local
.env.production

# =============================================================================
# Browser Extension
# =============================================================================

extension/icons/*.png
extension/icons/*.jpg
extension/icons/*.svg

# =============================================================================
# Azure Functions
# =============================================================================

local.settings.json
output/
*.epub
.api

# =============================================================================
# .NET / C#
# =============================================================================

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml